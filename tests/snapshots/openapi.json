  "info": {
    "title": "Retenção do assistente — WildChat-1M (Brasil)",
    "version": "1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/fatores/efeitos": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "pais",
            "required": false,
            "schema": {
              "default": "Brazil",
              "type": "string"
            }
          },
          {
            "description": "ajustado (regressão, mesmo mês e perfil) | bruto (sem ajuste)",
            "in": "query",
            "name": "ajuste",
            "required": false,
            "schema": {
              "default": "ajustado",
              "enum": [
                "ajustado",
                "bruto"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Efeitos"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Efeito de cada nível contra a referência, em p.p., com IC 95%: bruto ou ajustado (regressão linear).",
        "tags": [
          "fatores"
        ]
      }
    },
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Estado da API, do banco e da última carga.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/kpis": {
      "get": {
        "parameters": [
          {
            "description": "País (BDR-007: só Brazil na entrega)",
            "in": "query",
            "name": "pais",
            "required": false,
            "schema": {
              "default": "Brazil",
              "type": "string"
            }
          },
          {
            "description": "1º dia da 1ª sessão, inclusive (São Paulo)",
            "in": "query",
            "name": "inicio",
            "required": false,
            "schema": {
              "default": null,
              "format": "date",
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Último dia da 1ª sessão, inclusive",
            "in": "query",
            "name": "fim",
            "required": false,
            "schema": {
              "default": null,
              "format": "date",
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Kpis"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Novatos, retorno em 7 dias e % de recusa total na 1ª conversa, com IC 95% de Wilson.",
        "tags": [
          "kpis"
        ]
      }
    },
    "/api/retencao/coortes": {
      "get": {
        "description": "Nível com menos de 20 novatos volta com `suprimido_k = true` e sem números (k-anonimato).",
        "parameters": [
          {
            "description": "País (BDR-007: só Brazil na entrega)",
            "in": "query",
            "name": "pais",
            "required": false,
            "schema": {
              "default": "Brazil",
              "type": "string"
            }
          },
          {
            "description": "1º dia da 1ª sessão, inclusive (São Paulo)",
            "in": "query",
            "name": "inicio",
            "required": false,
            "schema": {
              "default": null,
              "format": "date",
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Último dia da 1ª sessão, inclusive",
            "in": "query",
            "name": "fim",
            "required": false,
            "schema": {
              "default": null,
              "format": "date",
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "mes | semana | periodo (o período todo, por nível)",
            "in": "query",
            "name": "granularidade",
            "required": false,
            "schema": {
              "default": "mes",
              "enum": [
                "mes",
                "semana",
                "periodo"
              ],
              "type": "string"
            }
          },
          {
            "description": "Abre a taxa por nível desta dimensão",
            "in": "query",
            "name": "dimensao",
            "required": false,
            "schema": {
              "default": "geral",
              "enum": [
                "geral",
                "tema_grupo",
                "tema",
                "familia_modelo",
                "dispositivo",
                "idioma_3",
                "faixa_horaria",
                "resposta_quartil",
                "recusa_total",
                "estado_grupo"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coortes"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Retorno em 7 dias por coorte (mês ou semana) ou no período, opcionalmente aberto por uma dimensão.",
        "tags": [
          "retencao"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Indicadores principais do período",
      "name": "kpis"
    },
    {
      "description": "Retorno em 7 dias por coorte",
      "name": "retencao"
    },
    {
      "description": "Efeito de cada fator",
      "name": "fatores"
    },
    {
      "description": "Estado da API e do banco",
      "name": "health"
    }
  ]
}
