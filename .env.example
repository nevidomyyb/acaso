# Copie para .env e preencha. O .env NÃO vai para o git.
# Opcional: o `docker compose up` sobe sem credenciais (classificação já vem pronta em data/enriched/).
# As credenciais só são usadas para reprocessar a classificação no Bedrock.

# Credenciais do usuário IAM do projeto (permissões em infra/aws/iam/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Classificação em batch no Bedrock (etl/classify_bedrock.py enviar-batch)
ACASO_S3_BUCKET=
ACASO_BEDROCK_ROLE_ARN=
