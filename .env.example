# Copie para .env e preencha. O .env NÃO vai para o git.
# Opcional: o `docker compose up` sobe sem credenciais (classificação já vem pronta em data/enriched/).
# As credenciais só são usadas para refazer a classificação na EC2 (ADR-004).

# Credenciais do usuário IAM do projeto (permissões em infra/aws/iam/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Bucket do projeto: entrada e saída da classificação (prefixo cpu/)
ACASO_S3_BUCKET=
